
{
  "schemaVersion": 1,
  "id": "heapshift",
  "version": "${version}",
  "name": "HeapShift",
  "description": "Dynamically adjusts ZGC soft heap targets based on Minecraft window focus and fixes memory leaks.",
  "authors": [
    "Molten"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.memorymanager.MemoryManagerClient"
    ]
  },
  "mixins": [
    "heapshift.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.7.10",
    "java": ">=17"
  }
}
